# Discord bot credentials
DISCORD_TOKEN=
APPLICATION_ID=
# Optional. Set to the primary server ID for guild-scoped command sync.
GUILD_ID=

# Supabase server-side credentials used by the bot. Never expose SUPABASE_KEY
# in frontend/VITE_* variables; use the anon key for the public website instead.
SUPABASE_URL=
SUPABASE_KEY=

# API-Sports server-side key for player and game lookups/cache misses.
API_SPORTS_KEY=

# Required for image-based play parsing. The model list is tried in order.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_VISION_MODELS=gpt-5.4-mini,gpt-5.5

# Discord channel IDs. CONFIRMATION_CHANNEL_ID, OFFICIAL_CHANNEL_ID, and
# RESULT_CHANNEL_ID are needed for normal posting/tracker operation.
OFFICIAL_CHANNEL_ID=
IMAGE_INPUT_CHANNEL_ID=
CONFIRMATION_CHANNEL_ID=
TEST_CHANNEL_ID=
TEAM_STATS_CHANNEL_ID=
RESULT_CHANNEL_ID=

# Set true only while testing; test posts route to TEST_CHANNEL_ID.
TESTING=false

# Optional ISO date (YYYY-MM-DD) for tracker history cutoff; blank includes all.
TRACKER_START_DATE=

# Comma-separated Discord role IDs. Configure both before production use.
OFFICIAL_ROLE_IDS=
OPERATOR_ROLE_IDS=

# Browser-safe Supabase settings for the public website only.
# Put these in web/.env.local (Vite does not load this root .env file).
# The anon key is public; never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=